# PostgreSQL (Neon / Vercel Postgres / Supabase)
# DATABASE_URL = pooled connection, DIRECT_URL = direct (non-pooled) connection used by migrations
DATABASE_URL="postgresql://user:password@host:5432/focushub?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/focushub?sslmode=require"

# NextAuth - generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional - without it, YouTube oEmbed is used (no video duration)
YOUTUBE_API_KEY=""

# SMTP for password reset OTP emails (e.g. Mailtrap, Gmail app password, Resend SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""
FROM_NAME="FocusHub"
