# PostgreSQL on Neon - filled in by `neon deploy` / `neon env pull`
# DATABASE_URL = pooled (-pooler host) for app queries
# DATABASE_URL_UNPOOLED = direct connection, used by `prisma migrate`
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_BRANCH="production"

# NextAuth - generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional - without it, YouTube oEmbed is used (no video duration)
YOUTUBE_API_KEY=""

# SMTP for password reset OTP emails (e.g. Mailtrap, Gmail app password, Resend SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""
FROM_NAME="FocusHub"
